# Copy to .env for local development. Never commit a real .env.
#
# In the pipeline these are supplied differently: NODE_ENV/PORT/DATA_FILE come
# from ecosystem.config.js, and JWT_SECRET is injected by Jenkins from its
# credential store at deploy time.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Signing key for API tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=2h

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

DATA_FILE=./data/development.json
