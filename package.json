{
  "name": "sentinel-api",
  "version": "1.0.0",
  "description": "Sentinel API - a vulnerability finding tracker REST API used as the subject of a 7-stage Jenkins DevOps pipeline (SIT223/SIT753 7.3HD).",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src scripts tests --max-warnings=0",
    "lint:report": "eslint src scripts tests -f json -o reports/eslint-report.json",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:smoke": "node scripts/smoke-test.js",
    "security:audit": "node scripts/security-gate.js",
    "build": "node scripts/build.js",
    "package": "node scripts/package-artifact.js",
    "monitor:check": "node scripts/monitoring-check.js",
    "monitor:incident": "node scripts/simulate-incident.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "pm2": "^7.0.4",
    "sonarqube-scanner": "^5.0.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
